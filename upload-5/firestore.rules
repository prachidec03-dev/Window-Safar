rules_version = '2';
// Window Safar · Firestore security rules.
// Each person can read and change only their own document, and can never set the Pass fields:
// only the server (pass-verify and razorpay-webhook, using the service account) writes those.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isMe() { return request.auth != null && request.auth.uid == uid; }
      function passFields() { return ['pass', 'passUntil', 'passPaymentId', 'passOrderId', 'passUpdated']; }
      allow read: if isMe();
      allow create: if isMe() && !request.resource.data.keys().hasAny(passFields());
      allow update: if isMe() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(passFields());
      allow delete: if isMe();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
